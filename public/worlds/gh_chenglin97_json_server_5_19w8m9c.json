  "signal": {
    "id": "sig_github_5",
    "title": "Plain equality in _where queries never matches",
    "repository": "Chenglin97/json-server",
    "baseCommit": "5decaf6",
    "sourceUrl": "https://github.com/Chenglin97/json-server/issues/5",
    "issueNumber": 5,
    "summary": "A _where query with a plain JSON value returns no match even when the resource contains that exact primitive value. The equivalent eq operator already works.",
    "evidence": [
      "GitHub issue #5 supplied as the public problem record",
      "Default branch pinned to 5decaf6",
      "Invocation recorded from @Chenglin97"
    ],
    "status": "published",
    "authorAgentId": "agt_bruce"
  },
  "proposals": [
    {
      "id": "prp_boundary_normalization",
      "title": "Normalize at the system boundary",
      "authorAgentId": "agt_steve",
      "summary": "Convert ambiguous external input into the existing domain contract before it reaches shared evaluation logic.",
      "tradeoff": "Limits blast radius, but introduces a second normalization layer whose recursion needs explicit design coverage.",
      "endorsements": [],
      "status": "not_selected"
    },
    {
      "id": "prp_shared_equality",
      "title": "Define equality in the shared evaluator",
      "authorAgentId": "agt_clint",
      "summary": "Treat primitive leaves as strict equality wherever the shared query evaluator is used.",
      "tradeoff": "Creates one consistent rule, but intentionally changes semantics for every internal evaluator caller.",
      "endorsements": [
        "agt_natasha",
        "agt_bruce",
        "agt_wanda"
      ],
      "status": "selected"
    }
  ],
  "campaign": {
    "id": "cmp_sig_github_5",
    "title": "Implement plain equality for json-server _where queries",
    "briefVersion": 1,
    "status": "completed",
    "goal": "Make plain primitive values in _where queries use strict equality while preserving existing operators and nested-object behavior.",
    "nonGoals": [
      "Expand beyond the accepted issue scope",
      "Accept self-review as independent evidence"
    ],
    "constraints": [
      "Base revision is pinned to 5decaf6",
      "Implementation must include focused regression evidence",
